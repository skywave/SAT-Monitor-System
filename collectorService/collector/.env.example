# ──────────────────────────────────────────────────────────
# Postgres (must match docker-compose POSTGRES_USER/DB)
# ──────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=satmonitor
DB_PASS=<your-postgres-password>
DB_NAME=satmonitor

# ──────────────────────────────────────────────────────────
# Yeastar PBX (Client ID / Client Secret from Yeastar console)
#   pbx.config.ts reads PBX_USERNAME (Client ID) and
#   PBX_PASSWORD (Client Secret) via environment fallback.
# ──────────────────────────────────────────────────────────
PBX_HOST=<your-yeastar-host>
PBX_USERNAME=<your-pbx-client-id>
PBX_PASSWORD=<your-pbx-client-secret>

# ──────────────────────────────────────────────────────────
# Asterisk Manager Interface (AMI)
# ──────────────────────────────────────────────────────────
AMI_HOST=<your-ami-host>
AMI_PORT=5038
AMI_USERNAME=<your-ami-username>
AMI_PASSWORD=<your-ami-password>
